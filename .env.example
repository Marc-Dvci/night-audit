# Copy to .env and fill in what you use. Never commit .env. This lists every variable the code reads.
# The demo (docker compose up demo, or `nightaudit serve` over runs/demo) needs none of them.

# --- Vampires: your AWS account (apps/vampires/src/vampires/aws.py) -------------------------------------------------
# The AWS profile the connectors use. Give it a read-only role: the connectors only call Describe*, List*, Get*.
NIGHT_AUDIT_PROFILE=
# Your 12-digit account id. Fills {account_id} in the approvals and names the default CUR bucket.
NIGHT_AUDIT_ACCOUNT_ID=
# The S3 bucket of your Cost and Usage Report 2.0 export. Default: night-audit-cur-<account id>.
NIGHT_AUDIT_CUR_BUCKET=
# The name written as the approver of the approved changes.
NIGHT_AUDIT_APPROVER=

# Instead of a profile, boto3 also reads its standard variables. Use short-lived, read-only credentials.
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=

# --- Ghosts: staff access (apps/ghosts/src/ghosts/github.py) ----------------------------------------------------------
# A fine-grained token with organisation "Members: read", for controls/staff-access-github.yaml. The option
# token_env in the control can name another variable.
GITHUB_TOKEN=

# --- Deployment to AWS Lambda (deploy/) -----------------------------------------------------------------------------
# Set by the deployment on the functions, not by hand: the bucket the nights are kept in and the control to run.
# RUNS_BUCKET=
# CONTROL_FILE=aws-account.yaml
# Set by AWS Lambda itself; when present the connectors use the function's role and never a named profile.
# AWS_LAMBDA_FUNCTION_NAME=

# --- Tests ------------------------------------------------------------------------------------------------------------
# Set by CI: hypothesis uses fixed (derandomized) examples and no example database.
# CI=1
