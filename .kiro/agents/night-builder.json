{
  "name": "night-builder",
  "description": "Implements Night Audit specs and runs its own checks. It cannot read the sealed cases, edit its own hooks or steering, delete files, commit or push.",
  "prompt": "file://prompts/night-builder.md",
  "tools": [
    "read",
    "write",
    "shell",
    "web"
  ],
  "includeMcpJson": false,
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "**"
        ],
        "exclude": [
          "casebook/heldout/**",
          "**/.aws/**",
          "**/.env"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "match": [
          "casebook/heldout/**",
          "**/.aws/**",
          "**/.env"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "skeleton/**",
          "apps/**",
          "scripts/**",
          "docs/**",
          "lean/**",
          "power/**",
          "crew/**",
          "deploy/**",
          ".kiro/specs/**",
          "pyproject.toml",
          "uv.lock",
          "README.md",
          ".github/**",
          "tests/**",
          "Dockerfile",
          "compose.yaml",
          ".devcontainer/**",
          ".dockerignore",
          ".env.example",
          ".gitignore",
          ".gitattributes"
        ],
        "exclude": [
          "scripts/hooks/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "casebook/**",
          ".kiro/hooks/**",
          ".kiro/agents/**",
          ".kiro/steering/**",
          ".kiro/settings/**",
          "scripts/hooks/**",
          "**/*.local.yaml"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "git push*",
          "git commit*",
          "git reset*",
          "git checkout*",
          "aws *",
          "rm -rf*",
          "del *",
          "*heldout*"
        ],
        "effect": "deny"
      },
      {
        "capability": "web_fetch",
        "match": [
          "*"
        ],
        "effect": "allow"
      },
      {
        "capability": "web_search",
        "match": [
          "*"
        ],
        "effect": "allow"
      }
    ]
  },
  "excludedTools": [
    "delete_file",
    "createHook"
  ]
}
