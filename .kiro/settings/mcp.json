{
  "mcpServers": {
    "aws-api": {
      "command": "uvx",
      "args": ["awslabs.aws-api-mcp-server@latest"],
      "env": {
        "AWS_PROFILE": "night-audit",
        "AWS_REGION": "us-east-1",
        "READ_OPERATIONS_ONLY": "true",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false
    },
    "aws-billing": {
      "command": "uvx",
      "args": ["awslabs.billing-cost-management-mcp-server@latest"],
      "env": { "AWS_PROFILE": "night-audit", "AWS_REGION": "us-east-1", "FASTMCP_LOG_LEVEL": "ERROR" },
      "disabled": false
    },
    "aws-cloudtrail": {
      "command": "uvx",
      "args": ["awslabs.cloudtrail-mcp-server@latest"],
      "env": { "AWS_PROFILE": "night-audit", "AWS_REGION": "us-east-1", "FASTMCP_LOG_LEVEL": "ERROR" },
      "disabled": false
    }
  }
}
